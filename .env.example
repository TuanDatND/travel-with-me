# Copy this file to .env and replace values for your local machine.
# .env is ignored by Git and is loaded by src/main/resources/application.yml.

APP_NAME=treektour
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/treektour
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Database schema migrations
FLYWAY_ENABLED=true
# Keep false for a new database. Set true only when onboarding an existing schema.
FLYWAY_BASELINE_ON_MIGRATE=false

# Local development
THYMELEAF_CACHE=false
JPA_FORMAT_SQL=false
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=WARN

# Tour images (backend only; never expose the API secret to clients)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
